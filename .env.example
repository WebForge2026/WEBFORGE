# Supabase Configuration
# Create a free project at https://supabase.com and copy the values from
# Settings → API. These are safe to expose in the browser (anon key is public).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Dashboard Access
# The admin panel uses Supabase Auth (email/password).
# Create admin users in Supabase Dashboard → Authentication → Users.
